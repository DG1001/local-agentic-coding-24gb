{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1"
      },
      "models": {
        "gpt-oss-20b": {
          "name": "gpt-oss-20b (MLX MXFP4)",
          "tool_call": true,
          "limit": {
            "context": 32768,
            "output": 8192
          },
          "options": {
            "temperature": 0.6,
            "top_p": 0.95,
            "top_k": 20,
            "repetition_penalty": 1.05
          }
        },
        "bartowski/devstral-small-2-24b-instruct-2512": {
          "name": "Devstral 2 24B (GGUF IQ4_XS)",
          "tool_call": true,
          "limit": {
            "context": 16384,
            "output": 4096
          },
          "options": {
            "temperature": 0.6,
            "top_p": 0.95,
            "top_k": 20,
            "repetition_penalty": 1.05
          }
        },
        "devstral-small-2-24b-instruct-2512": {
          "name": "Devstral 2 24B (MLX MXFP4) - nur 4864 ctx auf 24GB",
          "tool_call": true,
          "limit": {
            "context": 4864,
            "output": 2048
          },
          "options": {
            "temperature": 0.6,
            "top_p": 0.95,
            "top_k": 20,
            "repetition_penalty": 1.05
          }
        },
        "qwen3.6-35b-a3b": {
          "name": "Qwen3.6-35B-A3B (MLX 3bit) - 3/6 unter Agentenprompt",
          "tool_call": true,
          "limit": {
            "context": 32768,
            "output": 8192
          },
          "options": {
            "temperature": 0.6,
            "top_p": 0.95,
            "top_k": 20,
            "repetition_penalty": 1.05
          }
        },
        "qwen3.8-27b": {
          "name": "Qwen3.8-27B (GGUF UD-IQ4_XS) - context minus output is OpenCode's compaction threshold",
          "tool_call": true,
          "limit": {
            "context": 24576,
            "output": 4096
          },
          "options": {
            "temperature": 0.6,
            "top_p": 0.95,
            "top_k": 20,
            "repetition_penalty": 1.05
          }
        }
      }
    },
    "turbofieldfare": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "TurboFieldfare (Gemma 4, SSD-Streaming)",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "apiKey": "local"
      },
      "models": {
        "gemma-4-26b-a4b-it": {
          "name": "Gemma 4 26B-A4B IT (2 GB RAM)",
          "tool_call": true,
          "limit": {
            "context": 16384,
            "output": 4096
          },
          "options": {
            "temperature": 0.6,
            "top_p": 0.95
          }
        }
      }
    }
  },
  "agent": {
    "build": {
      "temperature": 0.6,
      "top_p": 0.95,
      "options": {
        "top_k": 20,
        "repetition_penalty": 1.05
      }
    },
    "plan": {
      "temperature": 0.6,
      "top_p": 0.95,
      "options": {
        "top_k": 20,
        "repetition_penalty": 1.05
      }
    }
  },
  "model": "lmstudio/gpt-oss-20b",
  "small_model": "lmstudio/gpt-oss-20b"
}
